APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO

# PaddleOCR v5 local inference model directories.
OCR_DET_MODEL_DIR=/opt/image-translator/models/v5/PP-OCRv5_server_det
OCR_REC_MODEL_DIR=/opt/image-translator/models/v5/PP-OCRv5_server_rec
OCR_ORIENTATION_MODEL_DIR=/opt/image-translator/models/v5/PP-LCNet_x1_0_textline_ori
OCR_DEVICE=gpu:0
OCR_PRECISION=fp16
OCR_CPU_THREADS=8
OCR_WARMUP=true
OCR_MIN_SCORE=0.45

# Local Hugging Face model directory. Download it before starting in an offline network.
TRANSLATION_MODEL_DIR=/opt/image-translator/models/nllb-200-distilled-600M
TRANSLATION_DEVICE=cuda:0
TRANSLATION_DTYPE=float16
TRANSLATION_BATCH_SIZE=16
TRANSLATION_MAX_INPUT_TOKENS=512
TRANSLATION_MAX_NEW_TOKENS=256

# Translation backend. The LLM endpoint must implement OpenAI-compatible chat completions.
TRANSLATION_PROVIDER=llm
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=
LLM_MODEL=default/deepseek-v3-2
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1
LLM_BATCH_SIZE=8
LLM_MAX_BATCH_CHARS=1200
LLM_MAX_OUTPUT_TOKENS=4096
LLM_RETRY_COUNT=2
LLM_RETRY_BACKOFF_SECONDS=1
LLM_FALLBACK_TO_NLLB=true
LLM_USE_ENV_PROXY=false
LLM_PROXY=

# Optional fastText lid.176 model. Required only when source_language=auto.
LANGUAGE_ID_MODEL=/opt/image-translator/models/lid.176.bin

# Rendering font. Noto Sans CJK supports Chinese output well.
RENDER_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
RENDER_MIN_FONT_SIZE=10
RENDER_MAX_FONT_SIZE=64
RENDER_INPAINT_RADIUS=4
MAX_IMAGE_BYTES=20971520
MAX_IMAGE_PIXELS=40000000
