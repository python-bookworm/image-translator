# Docker image build matrix. These defaults target CUDA 12.6.
CUDA_IMAGE=nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04
PADDLE_INDEX_URL=https://www.paddlepaddle.org.cn/packages/stable/cu126/
PADDLE_VERSION=3.2.0
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
TORCH_VERSION=2.7.1

# Service and inference settings.
APP_PORT=8080
LOG_LEVEL=INFO
NVIDIA_VISIBLE_DEVICES=all
OCR_DEVICE=gpu:0
OCR_PRECISION=fp16
OCR_CPU_THREADS=8
OCR_WARMUP=true
OCR_MIN_SCORE=0.45
TRANSLATION_DEVICE=cuda:0
TRANSLATION_DTYPE=float16
TRANSLATION_BATCH_SIZE=16
TRANSLATION_MAX_INPUT_TOKENS=512
TRANSLATION_MAX_NEW_TOKENS=256
TRANSLATION_PROVIDER=llm
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=
LLM_MODEL=default/deepseek-v3-2
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1
LLM_BATCH_SIZE=24
LLM_FALLBACK_TO_NLLB=true

# Leave empty when models/lid.176.bin is absent. Users must select the source language.
# Set to /opt/image-translator/models/lid.176.bin after adding the model.
LANGUAGE_ID_MODEL=

RENDER_MIN_FONT_SIZE=10
RENDER_MAX_FONT_SIZE=64
RENDER_INPAINT_RADIUS=4
MAX_IMAGE_BYTES=20971520
MAX_IMAGE_PIXELS=40000000
