# Native Linux deployment. Use absolute paths.
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO

OCR_DET_MODEL_DIR=/data3/pypt/image-translator-poc/models/v5/PP-OCRv5_server_det
OCR_REC_MODEL_DIR=/data3/pypt/image-translator-poc/models/v5/PP-OCRv5_server_rec
OCR_ORIENTATION_MODEL_DIR=/data3/pypt/image-translator-poc/models/v5/PP-LCNet_x1_0_textline_ori
OCR_DEVICE=gpu:0
OCR_PRECISION=fp16
OCR_CPU_THREADS=8
OCR_WARMUP=true
OCR_MIN_SCORE=0.45

TRANSLATION_MODEL_DIR=/data3/pypt/image-translator-poc/models/nllb-200-distilled-600M
TRANSLATION_DEVICE=cuda:0
TRANSLATION_DTYPE=float16
TRANSLATION_BATCH_SIZE=16
TRANSLATION_MAX_INPUT_TOKENS=512
TRANSLATION_MAX_NEW_TOKENS=256

# Translation backend: llm is recommended for quality; nllb remains available offline.
TRANSLATION_PROVIDER=llm
LLM_BASE_URL=https://llmproxy.gwm.cn/v1
LLM_API_KEY=prBaHQ+wFYWHdBad2h8FcOl77+Wlj6UKjA4MkJL9ivY064V2Gp2jtugGnw+/P1K4yTlNIxdIozgY
LLM_MODEL=default/deepseek-v4-flash
LLM_TIMEOUT_SECONDS=300
LLM_TEMPERATURE=0.1
LLM_BATCH_SIZE=8
LLM_MAX_BATCH_CHARS=1200
LLM_MAX_OUTPUT_TOKENS=4096
LLM_RETRY_COUNT=2
LLM_RETRY_BACKOFF_SECONDS=1
# Do not inherit HTTP(S)_PROXY by default. Set true only when the LLM endpoint
# must be reached through the company proxy.
LLM_USE_ENV_PROXY=false
# Optional explicit proxy, for example http://proxy.company:8080
LLM_PROXY=
# Load NLLB only if the LLM call fails. Set false when Torch/NLLB is not installed.
LLM_FALLBACK_TO_NLLB=true

# Leave empty until lid.176.bin and requirements-language-id.txt are installed.
LANGUAGE_ID_MODEL=

RENDER_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
RENDER_MIN_FONT_SIZE=10
RENDER_MAX_FONT_SIZE=64
RENDER_INPAINT_RADIUS=4
MAX_IMAGE_BYTES=20971520
MAX_IMAGE_PIXELS=40000000

# Keep model libraries offline at runtime.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
